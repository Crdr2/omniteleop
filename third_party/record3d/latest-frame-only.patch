+            // 2.5 Latest-wins: if more messages are already queued on the socket, the one just
+            // received is stale -- skip its (expensive) decode entirely and replace it with the
+            // newer message, repeating until the socket goes quiet. Only the newest available
+            // frame reaches step 3. This bounds end-to-end lag to ~one frame instead of letting
+            // TCP backpressure accumulate an unbounded stale-frame backlog.
+            if ( latestFrameOnly_.load())
+            {
+                bool receiveFailed = false;
+                uint32_t numDrainedThisPass = 0;
+                // Cap the drain per delivery and re-check the flags each round: a
+                // finite backlog still clears within a few deliveries, while a
+                // pathological always-readable socket cannot starve delivery or
+                // keep Disconnect()/a flag flip from taking effect.
+                while ( connectionEstablished_.load() && latestFrameOnly_.load()
+                        && numDrainedThisPass < DRAIN_MAX_FRAMES_PER_DELIVERY )
+                {
+                    PeerTalkHeader nextHeader;
+                    uint32_t numPeeked = 0;
+                    int rc = usbmuxd_recv_timeout( socketHandle_, (char*) &nextHeader,
+                                                   sizeof( nextHeader ), &numPeeked,
+                                                   DRAIN_POLL_TIMEOUT_MS );
+                    // Timeout (rc == 0 && numPeeked == 0): nothing queued, current frame is
+                    // the newest. Negative rc: socket error/closed -- let the outer loop's
+                    // next blocking read handle it.
+                    if ( rc != 0 || numPeeked == 0 )
+                    { break; }
+
+                    if ( numPeeked < sizeof( nextHeader ))
+                    {
+                        uint32_t numRestBytes = sizeof( nextHeader ) - numPeeked;
+                        if ( ReceiveWholeBuffer( socketHandle_, ((uint8_t*) &nextHeader) + numPeeked,
+                                                 numRestBytes ) != numRestBytes )
+                        {
+                            receiveFailed = true;
+                            break;
+                        }
+                    }
+
+                    uint32_t nextBodySize = NTOHL_( nextHeader.body_size );
+                    // A body must at least hold the fixed-size prefix parsed in step 3, and a
+                    // huge length means a corrupt/desynced stream -- bail out rather than
+                    // attempting a multi-GiB allocation or parsing stale tail bytes.
+                    constexpr uint32_t minBodySize = sizeof( Record3DHeader )
+                                                     + sizeof( IntrinsicMatrixCoeffs )
+                                                     + sizeof( CameraPose );
+                    constexpr uint32_t maxBodySize = 128u * 1024u * 1024u;
+                    if ( nextBodySize < minBodySize || nextBodySize > maxBodySize )
+                    {
+                        receiveFailed = true;
+                        break;
+                    }
+                    if ( rawMessageBuffer.size() < nextBodySize )
+                    { rawMessageBuffer.resize( nextBodySize ); }
+                    if ( ReceiveWholeBuffer( socketHandle_, (uint8_t*) rawMessageBuffer.data(),
+                                             nextBodySize ) != nextBodySize )
+                    {
+                        receiveFailed = true;
+                        break;
+                    }
+
+                    messageBodySize = nextBodySize;
+                    skippedFrames_.fetch_add( 1 );
+                    numDrainedThisPass++;
+                }
+                if ( receiveFailed )
+                { break; }
+            }
+
